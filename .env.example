NODE_ENV=development
FREE_MODE=true
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://squadup:squadup@localhost:5432/squadup
DATABASE_SSL=false
JWT_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
